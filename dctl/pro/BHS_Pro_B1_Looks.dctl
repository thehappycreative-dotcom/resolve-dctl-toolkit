        L.mono = 1.0f; L.con = 1.16f; L.toe = 0.65f; L.sho = 0.45f; L.fade = 0.6f; L.gam = make_float3(1.012f, 1.003f, 0.985f);
        L.hiT = make_float3(0.9f, 0.4f, -1.0f); L.shT = make_float3(0.5f, 0.2f, -0.5f);
    }
    return L;
}

__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y, float p_R, float p_G, float p_B)
{
    float3 nat = bhs_in(make_float3(p_R, p_G, p_B), ws);
    float3 src = bhs_pos(nat);

    bhs_look L = bhs_look_scale(bhs_get_look(look), toneAmt * strength, colAmt * strength);
    L.expo += expo;
    L.con *= con;
    L.sat *= sat;
    L.dens += dens;
    L.bal.x += warm * 2.5f + tint * 1.0f;
    L.bal.y += warm * 0.4f - tint * 1.8f;
    L.bal.z += -warm * 3.0f + tint * 1.0f;
    L.fade += fade * 4.0f;
    float3 res = bhs_look_apply(src, L);

    if (skinKeep > 0.0f) {
        float w = bhs_skin(src.x, src.y, src.z) * skinKeep;
        if (w > 0.0f) {
            bhs_look T = bhs_look_scale(bhs_get_look(look), toneAmt * strength, 0.0f);
            T.expo += expo;
            T.con *= con;
            T.fade += fade * 4.0f;
            float3 t = bhs_look_apply(src, T);
            res.x += (t.x - res.x) * w;
            res.y += (t.y - res.y) * w;
            res.z += (t.z - res.z) * w;
        }
    }
    float3 fin = bhs_out(res, nat, ws);
    return make_float3(fin.x, fin.y, fin.z);
}
