    else if (id == 15) {   // Clean Commercial
        L.con = 1.08f; L.toe = 0.8f; L.sho = 0.35f; L.sat = 1.05f; L.cmax = 1.0f; L.dens = 0.06f; L.bal = make_float3(0.1f, 0.0f, -0.1f);
        L.hiT = make_float3(0.2f, 0.1f, -0.3f); L.hiSat = 0.9f; L.vO = make_float3(0.0f, 0.03f, 0.04f); L.vG = make_float3(-4.0f, -0.06f, -0.04f);
        L.vB = make_float3(-3.0f, 0.0f, -0.06f);
    }
    else if (id == 16) {   // Creamy Skin Glow
        L.con = 1.02f; L.toe = 0.95f; L.sho = 0.5f; L.expo = 0.12f; L.fade = 0.5f; L.sat = 0.96f; L.cmax = 0.84f;
        L.bal = make_float3(0.4f, 0.15f, -0.4f); L.hiT = make_float3(0.9f, 0.5f, -1.1f); L.hiSat = 0.8f; L.vR = make_float3(5.0f, -0.08f, 0.04f);
        L.vO = make_float3(2.0f, 0.02f, 0.1f); L.vY = make_float3(-4.0f, -0.08f, 0.04f); L.vG = make_float3(-8.0f, -0.16f, 0.0f);
        L.vB = make_float3(-6.0f, -0.1f, 0.0f);
    }
    else if (id == 17) {   // Cool Steel
        L.con = 1.16f; L.toe = 0.55f; L.sho = 0.4f; L.sat = 0.68f; L.cmax = 0.8f; L.dens = 0.1f; L.bal = make_float3(-0.5f, 0.0f, 0.6f);
        L.shT = make_float3(-0.8f, 0.2f, 0.9f); L.hiT = make_float3(-0.1f, 0.1f, 0.2f); L.vO = make_float3(0.0f, 0.1f, 0.0f);
        L.vB = make_float3(-8.0f, 0.0f, -0.1f);
    }
    else if (id == 18) {   // Two Strip
        L.con = 1.12f; L.toe = 0.65f; L.sho = 0.4f; L.sat = 1.0f; L.cmax = 0.92f; L.dens = 0.14f; L.shT = make_float3(-0.6f, 0.3f, 0.4f);
        L.hiT = make_float3(0.6f, 0.2f, -0.5f); L.vR = make_float3(8.0f, 0.06f, -0.08f); L.vO = make_float3(-4.0f, 0.06f, 0.0f);
